# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.egg

# Virtual environments
.venv
venv/
env/
ENV/

# IDE
.idea/
.vscode/
.claude/
*.swp
*.swo
*~
.DS_Store

# Environment variables
.env
.env.local
.env.*.local

# Data directories (large files, generated data)
data/
openalex_data/
*.parquet
*.csv
*.json.gz

# PDF files
*.pdf

# Model weights and caches
models/
.cache/
*.ckpt
*.pth
*.bin
*.safetensors

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*.ipynb
# Allow individual notebooks for submission
!notebooks/*.ipynb

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff
.ruff_cache/

# UV
.uv/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Archive (old code - optional, remove this line if you want to track archive)
archive/.worktrees/

# LaTeX build artifacts
*.aux
*.blg
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
missfont.log

# Generated reports and visualizations
report/*.html
report/*.json
report/*.png
report/plots/

# ACL Anthology bib (~42 MB) — lives in Overleaf only, not in VCS.
# Re-fetch with: curl -L -o anthology.bib https://aclanthology.org/anthology.bib
report/**/anthology.bib

# marimo notebook session state — local-only, not for VCS
notebooks/marimo/__marimo__/

# Human-eval rater fill-in files — annotated locally, joined via
# scripts/compute_human_eval_kappa.py. The sample.csv + ground_truth.json
# are reproducible from `sample_human_eval.py --seed 2026` and are committed
# (whitelisted below to bypass the broader *.csv rule above).
evaluation/faithfulness/human_eval/rater_*.csv
!evaluation/faithfulness/human_eval/sample.csv
!evaluation/faithfulness/human_eval/ground_truth.json
