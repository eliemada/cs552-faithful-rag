    "CRAG_RUN_LIVE = os.environ.get(\"CRAG_RUN_LIVE\", \"0\") == \"1\"\n",
    "if not CRAG_RUN_LIVE:\n",
    "    print(\n",
    "        \"Skipped live CRAG micro-demo (n=10). Set CRAG_RUN_LIVE=1 to run it. \"\n",
    "        \"Canonical full-gold results load below from the committed sweep JSON.\"\n",
    "    )\n",
    "else:\n",
    "    import numpy as np\n",
    "    import matplotlib.pyplot as plt\n",
    "\n",
    "    highs = [0.6, 0.7, 0.8]\n",
    "    lows = [0.2, 0.3, 0.4]\n",
    "\n",
    "    rows = []\n",
    "    for tau_high in highs:\n",
    "        for tau_low in lows:\n",
    "            if tau_low >= tau_high:\n",
    "                continue\n",
    "            config = CRAGConfig(\n",
    "                confidence_threshold_high=tau_high,\n",
    "                confidence_threshold_low=tau_low,\n",
    "                max_retries=2,\n",
    "            )\n",
    "            total_latency = 0.0\n",
    "            total_rounds = 0\n",
    "            correct = 0\n",
    "            for item in gold_subset:\n",
    "                question = item[\"question\"]\n",
    "                t0 = time.perf_counter()\n",
    "                result = corrective_rag(question, retriever_fn, config=config)\n",
    "                total_latency += time.perf_counter() - t0\n",
    "                total_rounds += result.retrieval_rounds\n",
    "                if result.quality == RetrievalQuality.CORRECT:\n",
    "                    correct += 1\n",
    "            avg_latency = total_latency / len(gold_subset)\n",
    "            avg_rounds = total_rounds / len(gold_subset)\n",
    "            correct_rate = correct / len(gold_subset)\n",
    "            rows.append(\n",
    "                {\n",
    "                    \"tau_high\": tau_high,\n",
    "                    \"tau_low\": tau_low,\n",
    "                    \"correct_rate\": correct_rate,\n",
    "                    \"delta_correct\": correct_rate - baseline_correct_rate,\n",
    "                    \"avg_rounds\": avg_rounds,\n",
    "                    \"avg_latency_s\": avg_latency,\n",
    "                }\n",
    "            )\n",
    "\n",
    "    sweep_df = pd.DataFrame(rows)\n",
    "    summary = sweep_df.sort_values(\n",
