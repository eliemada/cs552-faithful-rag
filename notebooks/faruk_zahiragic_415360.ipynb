  {
   "cell_type": "markdown",
   "id": "5c77d6da",
   "metadata": {},
   "source": [
    "### Method summary\n",
    "\n",
    "We evaluate Corrective RAG in three stages:\n",
    "1. **Probe & slice**: scan the gold pool, auto-tune τ_high if the default slice has too few ambiguous retrievals, and keep a **mixed** eval set (correct + ambiguous + incorrect).\n",
    "2. **Baseline**: retrieve top-$k$ chunks and score quality (CORRECT / AMBIGUOUS / INCORRECT).\n",
    "3. **Correction loop**: when AMBIGUOUS, refine the query and re-retrieve (up to 2 rounds).\n",
    "\n",
    "The sweep below varies $(\\tau_{high}, \\tau_{low})$ on the same mixed slice.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "9b6b1896",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-06T18:52:22.407769Z",
     "iopub.status.busy": "2026-06-06T18:52:22.407526Z",
     "iopub.status.idle": "2026-06-06T18:52:22.427617Z",
     "shell.execute_reply": "2026-06-06T18:52:22.427066Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Skipped live CRAG micro-demo (n=10). Set CRAG_RUN_LIVE=1 to run it. Canonical full-gold results load below from the committed sweep JSON.\n"
     ]
    }
   ],
   "source": [
    "import os\n",
    "CRAG_RUN_LIVE = os.environ.get(\"CRAG_RUN_LIVE\", \"0\") == \"1\"\n",
    "if not CRAG_RUN_LIVE:\n",
    "    print(\n",
    "        \"Skipped live CRAG micro-demo (n=10). Set CRAG_RUN_LIVE=1 to run it. \"\n",
    "        \"Canonical full-gold results load below from the committed sweep JSON.\"\n",
    "    )\n",
    "else:\n",
    "    import sys\n",
    "    import time\n",
    "\n",
    "    import pandas as pd\n",
    "\n",
    "    from evaluation.common import available_models, generate\n",
    "    from evaluation.crag.corrective_rag import CRAGConfig, evaluate_retrieval_quality\n",
    "\n",
    "    shared_path = REPO_ROOT / \"packages\" / \"shared\"\n",
    "    if shared_path.exists() and str(shared_path) not in sys.path:\n",
    "        sys.path.insert(0, str(shared_path))\n",
    "\n",
    "    from rag_pipeline.rag.embedder import SentenceTransformerEmbedder\n",
    "    from rag_pipeline.rag.retriever import HybridRetriever, SearchResult\n",
    "\n",
    "    if not gold:\n",
    "        raise RuntimeError(\"Gold Q&A file is empty; cannot run baseline.\")\n",
    "\n",
    "    MAX_PROBE = int(os.environ.get(\"CRAG_PROBE_SIZE\", \"40\"))\n",
    "    MIN_AMBIGUOUS = int(os.environ.get(\"CRAG_MIN_AMBIGUOUS\", \"2\"))\n",
    "    MAX_QUESTIONS = int(os.environ.get(\"CRAG_MAX_QUESTIONS\", \"10\"))\n",
    "    TOP_K = int(os.environ.get(\"CRAG_TOP_K\", \"5\"))\n",
    "    EVAL_TAU_LOW = float(os.environ.get(\"CRAG_EVAL_TAU_LOW\", \"0.3\"))\n",
    "    _eval_tau_high_env = os.environ.get(\"CRAG_EVAL_TAU_HIGH\")\n",
    "\n",
    "    indexes_dir = ART / \"indexes\"\n",
    "    bge_index = indexes_dir / \"bge_m3_coarse.faiss\"\n",
    "    bge_meta = indexes_dir / \"bge_m3_coarse_metadata.json\"\n",
    "\n",
    "    probe_pool = gold[: min(MAX_PROBE, len(gold))]\n",
    "\n",
    "    if bge_index.exists() and bge_meta.exists():\n",
    "        embedder = SentenceTransformerEmbedder(\"BAAI/bge-m3\", short_name=\"bge_m3\")\n",
    "        retriever = HybridRetriever.from_path(\n",
    "            indexes_dir=indexes_dir,\n",
    "            chunk_type=\"coarse\",\n",
    "            embedder=embedder,\n",
    "            index_basename=\"bge_m3_coarse\",\n",
    "            zeroentropy_api_key=None,\n",
    "        )\n",
    "    elif os.environ.get(\"OPENAI_API_KEY\"):\n",
    "        retriever = HybridRetriever.from_path(\n",
    "            indexes_dir=indexes_dir,\n",
    "            chunk_type=\"coarse\",\n",
    "            openai_api_key=os.environ[\"OPENAI_API_KEY\"],\n",
    "            index_basename=\"coarse\",\n",
    "            zeroentropy_api_key=None,\n",
    "        )\n",
    "    else:\n",
    "        import faiss\n",
    "\n",
    "        from evaluation.common import load_paper_chunks\n",
    "\n",
    "        embedder = SentenceTransformerEmbedder(\"BAAI/bge-m3\", short_name=\"bge_m3\")\n",
    "\n",
    "        paper_ids = set()\n",
    "        for item in probe_pool:\n",
    "            for claim in item.get(\"claims\", []):\n",
    "                for span in claim.get(\"supporting_spans\", []):\n",
    "                    pid = span.get(\"paper_id\")\n",
    "                    if pid:\n",
    "                        paper_ids.add(pid)\n",
    "\n",
    "        if not paper_ids:\n",
    "            raise RuntimeError(\"No paper IDs found in gold probe pool to build a mini index.\")\n",
    "\n",
    "        chunks = []\n",
    "        for pid in sorted(paper_ids):\n",
    "            chunks.extend(load_paper_chunks(pid, \"coarse\"))\n",
    "\n",
    "        texts = [c[\"text\"] for c in chunks]\n",
    "        embeddings = embedder.encode_passages(texts)\n",
    "        index = faiss.IndexFlatIP(embeddings.shape[1])\n",
    "        index.add(embeddings)\n",
    "\n",
    "        class MiniFaissRetriever:\n",
    "            def __init__(self, index, chunks, embedder):\n",
    "                self.index = index\n",
    "                self.chunks = chunks\n",
    "                self.embedder = embedder\n",
    "\n",
    "            def search(self, query, top_k=10, use_reranker=False):\n",
    "                query_vec = self.embedder.encode_queries([query])\n",
    "                distances, indices = self.index.search(query_vec, top_k)\n",
    "                results = []\n",
    "                for rank, (idx, score) in enumerate(zip(indices[0], distances[0])):\n",
    "                    if idx == -1:\n",
    "                        break\n",
    "                    chunk = self.chunks[idx]\n",
    "                    results.append(\n",
    "                        SearchResult(\n",
    "                            chunk_id=chunk.get(\"chunk_id\", str(idx)),\n",
    "                            paper_id=chunk.get(\"paper_id\", \"unknown\"),\n",
    "                            paper_title=chunk.get(\"paper_title\", \"\"),\n",
    "                            text=chunk.get(\"text\", \"\"),\n",
    "                            section_hierarchy=chunk.get(\"section_hierarchy\", []),\n",
    "                            score=float(score),\n",
    "                            rank=rank,\n",
    "                        )\n",
    "                    )\n",
    "                return results\n",
    "\n",
    "        retriever = MiniFaissRetriever(index, chunks, embedder)\n",
    "\n",
    "\n",
    "    def _as_dict(res):\n",
    "        return {\n",
    "            \"chunk_id\": res.chunk_id,\n",
    "            \"paper_id\": res.paper_id,\n",
    "            \"paper_title\": res.paper_title,\n",
    "            \"text\": res.text,\n",
    "            \"section_hierarchy\": res.section_hierarchy,\n",
    "            \"score\": res.score,\n",
    "            \"rank\": res.rank,\n",
    "        }\n",
    "\n",
    "\n",
    "    def _retrieve_docs(question):\n",
    "        results = retriever.search(question, top_k=TOP_K, use_reranker=False)\n",
    "        return [_as_dict(r) for r in results]\n",
    "\n",
    "\n",
    "    def _count_ambiguous(confidences, tau_high):\n",
    "        return sum(1 for c in confidences if EVAL_TAU_LOW <= c < tau_high)\n",
    "\n",
    "\n",
    "    def _quality_bucket(confidence, tau_high):\n",
    "        if confidence >= tau_high:\n",
    "            return \"correct\"\n",
    "        if confidence >= EVAL_TAU_LOW:\n",
    "            return \"ambiguous\"\n",
    "        return \"incorrect\"\n",
    "\n",
    "\n",
    "    probe_scores = []\n",
    "    for item in probe_pool:\n",
    "        docs = _retrieve_docs(item[\"question\"])\n",
    "        _, conf = evaluate_retrieval_quality(item[\"question\"], docs)\n",
    "        probe_scores.append({\"item\": item, \"confidence\": conf})\n",
    "\n",
    "    score_by_question = {row[\"item\"][\"question\"]: row for row in probe_scores}\n",
    "\n",
    "    base_items = gold[: min(MAX_QUESTIONS, len(gold))]\n",
    "    base_confidences = [score_by_question[item[\"question\"]][\"confidence\"] for item in base_items]\n",
    "\n",
    "    if _eval_tau_high_env is not None:\n",
    "        eval_tau_high = float(_eval_tau_high_env)\n",
    "    else:\n",
    "        eval_tau_high = 0.7\n",
    "        if _count_ambiguous(base_confidences, eval_tau_high) < MIN_AMBIGUOUS:\n",
    "            above_low = sorted(c for c in base_confidences if c >= EVAL_TAU_LOW)\n",
    "            if len(above_low) >= MIN_AMBIGUOUS:\n",
    "                eval_tau_high = round(min(above_low[MIN_AMBIGUOUS - 1] + 0.005, 0.95), 3)\n",
    "            else:\n",
    "                pool_above_low = sorted(r[\"confidence\"] for r in probe_scores if r[\"confidence\"] >= EVAL_TAU_LOW)\n",
    "                if len(pool_above_low) >= MIN_AMBIGUOUS:\n",
    "                    eval_tau_high = round(min(pool_above_low[MIN_AMBIGUOUS - 1] + 0.005, 0.95), 3)\n",
    "                elif pool_above_low:\n",
    "                    eval_tau_high = round(min(max(pool_above_low) + 0.005, 0.95), 3)\n",
    "                else:\n",
    "                    eval_tau_high = 0.85\n",
    "\n",
    "    EVAL_CONFIG = CRAGConfig(\n",
    "        confidence_threshold_high=eval_tau_high,\n",
    "        confidence_threshold_low=EVAL_TAU_LOW,\n",
    "    )\n",
    "\n",
    "    gold_subset = list(base_items)\n",
    "    base_buckets = {\n",
    "        item[\"question\"]: _quality_bucket(score_by_question[item[\"question\"]][\"confidence\"], eval_tau_high)\n",
    "        for item in gold_subset\n",
    "    }\n",
    "    n_ambiguous = sum(1 for b in base_buckets.values() if b == \"ambiguous\")\n",
    "\n",
    "    if n_ambiguous < MIN_AMBIGUOUS:\n",
    "        n_need = MIN_AMBIGUOUS - n_ambiguous\n",
    "        swap_candidates = [\n",
    "            row\n",
    "            for row in probe_scores\n",
    "            if row[\"item\"][\"question\"] not in base_buckets\n",
    "            and _quality_bucket(row[\"confidence\"], eval_tau_high) == \"ambiguous\"\n",
    "        ]\n",
    "        if len(swap_candidates) < n_need:\n",
    "            borderline = [\n",
    "                row\n",
    "                for row in probe_scores\n",
    "                if row[\"item\"][\"question\"] not in base_buckets\n",
    "                and row[\"confidence\"] >= EVAL_TAU_LOW\n",
    "            ]\n",
    "            borderline.sort(key=lambda row: abs(row[\"confidence\"] - eval_tau_high))\n",
    "            for row in borderline:\n",
    "                if row not in swap_candidates:\n",
    "                    swap_candidates.append(row)\n",
    "                if len(swap_candidates) >= n_need:\n",
    "                    break\n",
    "\n",
    "        drop_indices = [\n",
    "            i\n",
    "            for i, item in enumerate(gold_subset)\n",
    "            if base_buckets[item[\"question\"]] == \"correct\"\n",
    "        ]\n",
    "        drop_indices = drop_indices[-n_need:] if len(drop_indices) >= n_need else list(range(len(gold_subset)))[-n_need:]\n",
    "\n",
    "        for idx, row in zip(drop_indices, swap_candidates[:n_need]):\n",
    "            old_q = gold_subset[idx][\"question\"]\n",
    "            gold_subset[idx] = row[\"item\"]\n",
    "            del base_buckets[old_q]\n",
    "            base_buckets[row[\"item\"][\"question\"]] = _quality_bucket(row[\"confidence\"], eval_tau_high)\n",
    "\n",
    "    mix = {\"correct\": 0, \"ambiguous\": 0, \"incorrect\": 0}\n",
    "    for item in gold_subset:\n",
    "        mix[_quality_bucket(score_by_question[item[\"question\"]][\"confidence\"], eval_tau_high)] += 1\n",
    "\n",
    "    display(\n",
    "        Markdown(\n",
    "            f\"**Eval slice:** **{len(gold_subset)}** questions — \"\n",
    "            f\"**{mix['correct']}** correct, **{mix['ambiguous']}** ambiguous, **{mix['incorrect']}** incorrect \"\n",
    "            f\"(τ_high=**{eval_tau_high}**, τ_low=**{EVAL_TAU_LOW}**, probed **{len(probe_pool)}** for swaps). \"\n",
    "            f\"Tune via `CRAG_MIN_AMBIGUOUS`, `CRAG_PROBE_SIZE`, `CRAG_EVAL_TAU_HIGH`.\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    def _build_prompt(question, docs):\n",
    "        joined = \"\\n\\n\".join(\n",
    "            f\"[{i + 1}] {d['text'][:1000].strip()}\" for i, d in enumerate(docs)\n",
    "        )\n",
    "        return (\n",
    "            \"Answer the question using only the provided sources. \"\n",
    "            \"If the sources do not contain enough information, say you don't know.\\n\\n\"\n",
    "            f\"Question: {question}\\n\\nSources:\\n{joined}\\n\\nAnswer:\"\n",
    "        )\n",
    "\n",
    "\n",
    "    def _can_use_vllm():\n",
    "        try:\n",
    "            import torch\n",
    "\n",
    "            return torch.cuda.is_available()\n",
    "        except Exception:\n",
    "            return False\n",
    "\n",
    "\n",
    "    def _safe_generate(prompt, docs):\n",
    "        if not _can_use_vllm():\n",
    "            if docs:\n",
    "                return docs[0][\"text\"][:400].strip()\n",
    "            return \"I don't know.\"\n",
    "        try:\n",
    "            return generate(model_spec, prompt, max_tokens=256, temperature=0.2)\n",
    "        except Exception:\n",
    "            if docs:\n",
    "                return docs[0][\"text\"][:400].strip()\n",
    "            return \"I don't know.\"\n",
    "\n",
    "\n",
    "    model_spec = available_models(include_api=False)[0]\n",
    "\n",
    "    baseline_rows = []\n",
    "\n",
    "    for item in gold_subset:\n",
    "        question = item[\"question\"]\n",
    "        t0 = time.perf_counter()\n",
    "        docs = _retrieve_docs(question)\n",
    "        prompt = _build_prompt(question, docs)\n",
    "        answer = _safe_generate(prompt, docs)\n",
    "        elapsed = time.perf_counter() - t0\n",
    "        baseline_rows.append(\n",
    "            {\n",
    "                \"question\": question,\n",
    "                \"answer\": answer.strip(),\n",
    "                \"docs\": docs,\n",
    "                \"latency_s\": elapsed,\n",
    "            }\n",
    "        )\n",
    "\n",
    "    baseline_df = pd.DataFrame(baseline_rows)\n",
    "    display(baseline_df[[\"question\", \"latency_s\"]])"
   ]
  },
