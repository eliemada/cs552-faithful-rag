    "import os\n",
    "CRAG_RUN_LIVE = os.environ.get(\"CRAG_RUN_LIVE\", \"0\") == \"1\"\n",
    "if not CRAG_RUN_LIVE:\n",
    "    print(\n",
    "        \"Skipped live CRAG micro-demo (n=10). Set CRAG_RUN_LIVE=1 to run it. \"\n",
    "        \"Canonical full-gold results load below from the committed sweep JSON.\"\n",
    "    )\n",
    "else:\n",
    "    from evaluation.crag.corrective_rag import corrective_rag\n",
    "\n",
    "    crag_config = EVAL_CONFIG\n",
    "\n",
    "    display(\n",
    "        Markdown(\n",
    "            f\"CRAG loop: τ_high=**{crag_config.confidence_threshold_high}**, \"\n",
    "            f\"τ_low=**{crag_config.confidence_threshold_low}** (same as baseline evaluator).\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "    def retriever_fn(query, k=TOP_K):\n",
    "        results = retriever.search(query, top_k=k, use_reranker=False)\n",
    "        return [_as_dict(r) for r in results]\n",
    "\n",
    "\n",
    "    crag_rows = []\n",
    "    for item in gold_subset:\n",
    "        question = item[\"question\"]\n",
    "        t0 = time.perf_counter()\n",
    "        result = corrective_rag(question, retriever_fn, config=crag_config)\n",
    "        prompt = _build_prompt(question, result.final_documents)\n",
    "        answer = _safe_generate(prompt, result.final_documents)\n",
    "        elapsed = time.perf_counter() - t0\n",
    "        crag_rows.append(\n",
    "            {\n",
    "                \"question\": question,\n",
    "                \"answer\": answer.strip(),\n",
    "                \"quality\": result.quality.value,\n",
    "                \"confidence\": result.confidence,\n",
    "                \"retrieval_rounds\": result.retrieval_rounds,\n",
    "                \"refined_query\": result.refined_query,\n",
    "                \"latency_s\": elapsed,\n",
    "            }\n",
    "        )\n",
    "\n",
    "    crag_df = pd.DataFrame(crag_rows)\n",
    "\n",
    "    compare_df = baseline_df[[\"question\", \"quality\", \"confidence\"]].merge(\n",
    "        crag_df[[\"question\", \"quality\", \"confidence\", \"retrieval_rounds\", \"refined_query\"]],\n",
    "        on=\"question\",\n",
    "        suffixes=(\"_baseline\", \"_crag\"),\n",
    "    )\n",
    "    compare_df[\"confidence_delta\"] = compare_df[\"confidence_crag\"] - compare_df[\"confidence_baseline\"]\n",
    "    compare_df[\"quality_improved\"] = (\n",
    "        (compare_df[\"quality_baseline\"] != RetrievalQuality.CORRECT.value)\n",
    "        & (compare_df[\"quality_crag\"] == RetrievalQuality.CORRECT.value)\n",
    "    )\n",
    "    compare_df[\"refined\"] = compare_df[\"retrieval_rounds\"] > 1\n",
    "\n",
    "    baseline_rate = (compare_df[\"quality_baseline\"] == RetrievalQuality.CORRECT.value).mean()\n",
    "    crag_rate = (compare_df[\"quality_crag\"] == RetrievalQuality.CORRECT.value).mean()\n",
    "    n_refined = int(compare_df[\"refined\"].sum())\n",
    "    n_improved = int(compare_df[\"quality_improved\"].sum())\n",
    "\n",
    "    display(\n",
    "        Markdown(\n",
    "            f\"**CRAG impact:** baseline correct **{baseline_rate:.0%}** → CRAG correct **{crag_rate:.0%}** \"\n",
    "            f\"(Δ **{crag_rate - baseline_rate:+.0%}**); \"\n",
    "            f\"**{n_refined}** queries with >1 retrieval round; \"\n",
    "            f\"**{n_improved}** ambiguous/incorrect → correct.\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "    display(compare_df[\n",
    "        [\n",
    "            \"question\",\n",
    "            \"quality_baseline\",\n",
    "            \"confidence_baseline\",\n",
    "            \"quality_crag\",\n",
