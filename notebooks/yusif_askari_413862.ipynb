        "for k in lc_cfg_keys:\n",
        "    print(f\"  {k:<22} {cfg[k]}\")\n",
        "\n",
        "# Show how many cited papers each LC sample had to stitch together.\n",
        "gold = {q.query_id: q for q in resolve_from_file(DEFAULT_GOLD_QA)}\n",
        "print(\"\\nLong-context input size per sample:\")\n",
        "print(f\"  {'query_id':<8} {'#papers':>8}  paper_ids\")\n",
        "for row in results[\"long_context\"][\"per_sample\"]:\n",
        "    qid = row[\"query_id\"]\n",
        "    if qid in gold:\n",
