    "from IPython.display import Markdown, display\n",
    "from pathlib import Path\n",
    "import json\n",
    "\n",
    "M3_PATH = REPO_ROOT / \"evaluation/ragas_eval/results/03_three_way_n30.json\"\n",
    "ARM_LABELS = {\n",
    "    \"rag\": \"RAG · gemini-2.5-flash\",\n",
    "    \"rag_alt\": \"RAG · gpt-4o-mini\",\n",
    "    \"long_context\": \"LC · gemini-2.5-flash\",\n",
    "}\n",
    "\n",
    "if not M3_PATH.exists():\n",
    "    display(\n",
    "        Markdown(\n",
    "            f\"Missing `{M3_PATH.relative_to(REPO_ROOT)}`. \"\n",
    "            \"Pull latest `main` or re-run `scripts/run_ragas_experiment`.\"\n",
    "        )\n",
    "    )\n",
    "else:\n",
    "    block = json.loads(M3_PATH.read_text())\n",
    "    cfg = block[\"config\"]\n",
    "    rows = []\n",
    "    for key, label in ARM_LABELS.items():\n",
    "        arm = block[key]\n",
    "        agg = arm[\"aggregate\"]\n",
    "        usage = arm.get(\"usage\", {})\n",
    "        rows.append(\n",
    "            {\n",
    "                \"arm\": label,\n",
    "                **{m: round(agg[m], 3) for m in METRIC_NAMES},\n",
    "                \"usd_per_query\": round(usage.get(\"per_query_avg_cost_usd\", 0), 5),\n",
    "            }\n",
    "        )\n",
    "    m3_df = pd.DataFrame(rows).set_index(\"arm\")\n",
    "    display(\n",
    "        Markdown(\n",
    "            f\"**n = {block['rag']['n']}** · judge = `{cfg['judge_model']}` · \"\n",
    "            f\"retriever = `{cfg['retriever_config']}`\"\n",
    "        )\n",
    "    )\n",
    "    display(m3_df)\n",
    "\n",
    "    md_path = M3_PATH.with_suffix(\".md\")\n",
    "    if md_path.exists():\n",
    "        display(Markdown(md_path.read_text()))\n"
   ]
