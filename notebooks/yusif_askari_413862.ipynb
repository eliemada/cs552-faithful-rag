        "\n",
        "# Long-context baseline = concatenate every paper the gold question cites,\n",
        "# truncate each to `lc_chars_per_paper`, then answer in one shot. Default\n",
        "# model is gemini-2.5-flash (1M-token window).\n",
        "lc_cfg_keys = (\"answer_model_lc\", \"lc_chars_per_paper\")\n",
        "print(\"Long-context configuration\")\n",
